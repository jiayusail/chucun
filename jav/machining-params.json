[
{"q":"每齿进给fz计算公式是","opt":["A.fz=Z/S","B.fz=S/Z","C.fz=F*Z*S","D.fz=F/(Z*S)"],"ans":"D","tip":"每齿进给=进给速度/(齿数×转速)，是铣削核心参数。","cate":"加工参数"},
{"q":"线速度Vc计算公式是","opt":["A.Vc=πDS/1000","B.Vc=S/D","C.Vc=D*S","D.Vc=D/S"],"ans":"A","tip":"线速度Vc=π×刀具直径×转速/1000，单位m/min。","cate":"加工参数"},
{"q":"开粗加工优先选择","opt":["A.高转速小进给","B.小切深高转速","C.任意参数","D.大切深大进给低转速"],"ans":"D","tip":"开粗优先大切深大进给，最大化材料去除率。","cate":"加工参数"},
{"q":"精加工优先选择","opt":["A.小切深高转速小进给","B.低转速小进给","C.大切深低转速","D.任意参数"],"ans":"A","tip":"精加工优先高转速小进给，保证表面光洁度。","cate":"加工参数"},
{"q":"铝件加工转速一般","opt":["A.固定不变","B.偏高","C.偏低","D.极低"],"ans":"B","tip":"铝件导热好、硬度低，适合高速切削防粘刀。","cate":"加工参数"},
{"q":"铸铁加工特点","opt":["A.需要大量切削油","B.加工硬化严重","C.易粘刀","D.脆性大排屑好"],"ans":"D","tip":"铸铁脆性大，切屑呈粉末状，排屑好，可干式切削。","cate":"加工参数"},
{"q":"钛合金加工难点","opt":["A.排屑顺畅","B.易切削","C.导热差易粘刀","D.硬度低"],"ans":"C","tip":"钛合金导热极差，热量集中在刀尖，极易烧刀。","cate":"加工参数"},
{"q":"金刚石刀具最适合加工","opt":["A.钢件","B.铝合金、铜合金","C.不锈钢","D.铸铁"],"ans":"B","tip":"PCD刀具适合有色金属高光加工，表面质量极佳。","cate":"加工参数"},
{"q":"CBN立方氮化硼适合加工","opt":["A.铜件","B.铝件","C.塑料","D.淬火钢、高硬度材料"],"ans":"D","tip":"CBN专门加工淬硬钢，硬度可达HRC45以上。","cate":"加工参数"},
{"q":"立铣刀悬伸长度一般不超过","opt":["A.10倍","B.任意","C.3倍刀具直径","D.5倍"],"ans":"C","tip":"悬伸超过3倍刀具直径，刚性会急剧下降。","cate":"加工参数"},
{"q":"开槽加工侧吃刀量一般","opt":["A.很小","B.任意","C.小于直径一半","D.等于刀具直径"],"ans":"D","tip":"开槽满刃切削，注意降低转速和进给。","cate":"加工参数"},
{"q":"轮廓铣削侧吃刀量一般","opt":["A.大于直径","B.小于刀具直径一半","C.任意","D.等于直径"],"ans":"B","tip":"侧吃刀量小于直径一半，刀具受力小更稳定。","cate":"加工参数"},
{"q":"攻丝时转速必须","opt":["A.偏低","B.任意","C.偏高","D.极高"],"ans":"A","tip":"攻丝转速过高极易断锥，一般控制在100r/min以内。","cate":"加工参数"},
{"q":"盲孔攻丝深度要小于丝锥有效长度","opt":["A.看情况","B.否","C.是","D.无所谓"],"ans":"C","tip":"防止丝锥尾部无牙段撞底折断，预留2-3个螺距。","cate":"加工参数"},
{"q":"铣螺纹常用指令","opt":["A.G02圆弧","B.G01螺旋插补","C.G84攻丝","D.G00快速"],"ans":"B","tip":"用G01三轴联动螺旋插补铣螺纹，安全不易断刀。","cate":"加工参数"},
{"q":"型腔开粗优先采用","opt":["A.往复铣削","B.分层铣削","C.单向铣削","D.动态铣削"],"ans":"D","tip":"动态铣削刀具受力均匀，不易崩刀，效率更高。","cate":"加工参数"},
{"q":"曲面精加工优先使用","opt":["A.球刀","B.钻头","C.平底刀","D.牛鼻刀"],"ans":"A","tip":"球刀适合曲面仿形加工，表面质量好。","cate":"加工参数"},
{"q":"平面精加工常用","opt":["A.球刀","B.小立铣刀","C.大直径盘刀","D.丝锥"],"ans":"C","tip":"大直径面铣刀加工平面效率高，光洁度好。","cate":"加工参数"},
{"q":"刀具热胀刀柄优势","opt":["A.夹持刚性高同心度好","B.维护简单","C.便宜","D.装卸方便"],"ans":"A","tip":"热胀刀柄夹持同心度最高，适合高速精加工。","cate":"加工参数"},
{"q":"ER弹簧夹头特点","opt":["A.只适合大刀具","B.通用性强夹持范围大","C.同心度最好","D.刚性极高"],"ans":"B","tip":"ER夹头通用性强，是加工中心最常用刀柄。","cate":"加工参数"},
{"q":"切削速度过低会导致","opt":["A.刀具磨损加快","B.效率过高","C.排屑顺畅","D.光洁度变好"],"ans":"A","tip":"线速度过低，刀具与工件摩擦时间长，磨损加剧。","cate":"加工参数"},
{"q":"切削速度过高会导致","opt":["A.切削力减小","B.刀具烧损崩刃","C.刀具寿命提高","D.光洁度变好"],"ans":"B","tip":"速度过高，刀尖温度急剧升高，快速磨损烧损。","cate":"加工参数"},
{"q":"进给速度过大导致","opt":["A.效率降低","B.光洁度好","C.尺寸变小","D.刀具过载折断"],"ans":"D","tip":"进给过大会超出刀具承受能力，导致崩刀折断。","cate":"加工参数"},
{"q":"进给速度过小导致","opt":["A.尺寸稳定","B.排屑好","C.加工效率低易粘刀","D.刀具寿命长"],"ans":"C","tip":"进给过小，切削厚度太薄，易产生积屑瘤粘刀。","cate":"加工参数"},
{"q":"背吃刀量（切深）过大导致","opt":["A.机床负载过大震动","B.光洁度好","C.刀具寿命长","D.加工稳定"],"ans":"A","tip":"切深过大，机床和刀具超负荷，易产生震动。","cate":"加工参数"},
{"q":"高速加工参数特点是","opt":["A.低转速小进给","B.大切深大进给","C.高转速小切深大进给","D.低转速大切深"],"ans":"C","tip":"高速加工采用轻切快进策略，效率高质量好。","cate":"加工参数"},
{"q":"钢件开粗线速度一般为","opt":["A.100m/min以上","B.80-120m/min","C.50m/min以下","D.200m/min以上"],"ans":"B","tip":"普通45号钢开粗推荐线速度80-120m/min。","cate":"加工参数"},
{"q":"铝件开粗线速度一般为","opt":["A.50m/min","B.100m/min","C.200-500m/min","D.1000m/min以上"],"ans":"C","tip":"铝件适合高速切削，线速度200-500m/min。","cate":"加工参数"},
{"q":"不锈钢加工线速度应","opt":["A.提高","B.降低","C.不变","D.任意"],"ans":"B","tip":"不锈钢导热差，需降低线速度防止烧刀。","cate":"加工参数"},
{"q":"钛合金加工线速度应控制在","opt":["A.100m/min以上","B.200m/min以上","C.500m/min以上","D.30-80m/min"],"ans":"D","tip":"钛合金线速度不宜过高，30-80m/min最佳。","cate":"加工参数"},
{"q":"加工时出现震刀应首先","opt":["A.加大切深","B.提高转速","C.降低进给或转速","D.更换冷却液"],"ans":"C","tip":"震刀时先降低参数，再检查刀具刚性和装夹。","cate":"加工参数"},
{"q":"精加工时为提高光洁度应","opt":["A.提高转速降低每齿进给","B.加大切深","C.降低转速","D.加大进给"],"ans":"A","tip":"高转速小进给可获得更好的表面光洁度。","cate":"加工参数"},
{"q":"深孔加工时应","opt":["A.干切","B.提高转速","C.降低转速加大排屑","D.加大进给"],"ans":"C","tip":"深孔加工重点是排屑，需降低转速，定期退刀排屑。","cate":"加工参数"},
{"q":"攻丝时进给速度F应等于","opt":["A.转速","B.任意值","C.螺距","D.螺距×转速"],"ans":"D","tip":"攻丝进给F=螺距×转速，保证主轴与进给同步。","cate":"加工参数"},
{"q":"铣削平面时走刀方式优先选","opt":["A.往复走刀","B.螺旋走刀","C.任意","D.单向走刀"],"ans":"A","tip":"往复走刀效率最高，适合平面加工。","cate":"加工参数"},
{"q":"型腔加工时优先采用","opt":["A.任意","B.顺铣","C.混合铣","D.逆铣"],"ans":"B","tip":"型腔加工顺铣可提高表面质量，减少刀具磨损。","cate":"加工参数"},
{"q":"粗加工时切削液应","opt":["A.间断浇注","B.不用","C.充分浇注","D.少量"],"ans":"C","tip":"粗加工发热量大，需充分冷却防止刀具过热。","cate":"加工参数"},
{"q":"精加工时切削液应","opt":["A.间断","B.不用","C.少量","D.高压喷射"],"ans":"D","tip":"精加工高压喷射可冲走切屑，提高表面质量。","cate":"加工参数"},
{"q":"刀具磨损到什么程度应更换","opt":["A.任意时候","B.达到磨钝标准","C.崩刃后","D.完全磨损"],"ans":"B","tip":"达到磨钝标准就应更换，避免过度磨损损坏工件。","cate":"加工参数"},
{"q":"加工中心主轴转速S的单位是","opt":["A.r/min","B.mm/r","C.m/min","D.mm/min"],"ans":"A","tip":"S主轴转速单位是转/分钟（r/min）。","cate":"加工参数"},
{"q":"G94模式下F的单位是","opt":["A.r/min","B.mm/min","C.mm/r","D.m/min"],"ans":"B","tip":"G94每分钟进给，F单位mm/min，加工中心默认模式。","cate":"加工参数"},
{"q":"G95模式下F的单位是","opt":["A.m/min","B.r/min","C.mm/r","D.mm/min"],"ans":"C","tip":"G95每转进给，F单位mm/转，车削攻丝常用。","cate":"加工参数"},
{"q":"加工相同材料时，刀具直径越大转速应","opt":["A.任意","B.不变","C.越高","D.越低"],"ans":"D","tip":"线速度相同，直径越大转速越低。","cate":"加工参数"},
{"q":"加工相同材料时，刀具直径越小转速应","opt":["A.越高","B.不变","C.越低","D.任意"],"ans":"A","tip":"线速度相同，直径越小转速越高。","cate":"加工参数"},
{"q":"动态铣削的特点是","opt":["A.大切深大侧吃刀","B.小切深小进给","C.小切深大进给","D.大切深小侧吃刀高进给"],"ans":"D","tip":"动态铣削大切深小侧吃刀，刀具受力小效率高。","cate":"加工参数"},
{"q":"等高铣削适合加工","opt":["A.陡峭曲面","B.平面","C.平缓曲面","D.孔"],"ans":"A","tip":"等高铣适合陡峭侧壁加工，表面质量好。","cate":"加工参数"},
{"q":"平行铣削适合加工","opt":["A.孔","B.槽","C.陡峭曲面","D.平缓曲面"],"ans":"D","tip":"平行铣适合平缓曲面加工，效率高。","cate":"加工参数"},
{"q":"清根加工优先使用","opt":["A.大直径刀","B.钻头","C.小直径牛鼻刀或球刀","D.盘刀"],"ans":"C","tip":"清根用小直径刀具才能加工到根部。","cate":"加工参数"},
{"q":"钻孔时进给速度应","opt":["A.先慢后快","B.任意","C.先快后慢","D.均匀"],"ans":"D","tip":"钻孔进给应均匀，防止钻头折断。","cate":"加工参数"},
{"q":"铰孔时转速应比钻孔","opt":["A.低","B.高","C.相同","D.任意"],"ans":"A","tip":"铰孔转速要低，保证孔的光洁度和精度。","cate":"加工参数"},
{"q":"镗孔时为保证圆度应","opt":["A.加大进给","B.采用精镗循环","C.干切","D.提高转速"],"ans":"B","tip":"精镗循环可保证孔的圆度和同轴度。","cate":"加工参数"},
{"q":"铣削外轮廓时刀具补偿应","opt":["A.任意位置","B.在轮廓上建立","C.在轮廓内建立","D.在轮廓外建立"],"ans":"D","tip":"刀具补偿应在轮廓外直线段建立，避免过切。","cate":"加工参数"},
{"q":"铣削内轮廓时刀具补偿应","opt":["A.在轮廓内直线段建立","B.在轮廓上建立","C.任意位置","D.在轮廓外建立"],"ans":"A","tip":"内轮廓补偿在内部直线段建立，保证加工精度。","cate":"加工参数"},
{"q":"加工薄壁件时应采用","opt":["A.低转速大进给","B.大切深","C.小切深高进给","D.大切深低转速"],"ans":"C","tip":"薄壁件小切深高进给，减少切削力防止变形。","cate":"加工参数"},
{"q":"加工淬火钢时应采用","opt":["A.低转速小进给","B.高转速大进给","C.低转速大进给","D.高转速小进给"],"ans":"A","tip":"淬火钢硬度高，需低转速小进给，防止崩刀。","cate":"加工参数"},
{"q":"加工铜件时应防止","opt":["A.磨损","B.崩刃","C.粘刀","D.变形"],"ans":"C","tip":"铜件塑性好易粘刀，需用锋利刀具+充足冷却。","cate":"加工参数"},
{"q":"加工铸铁时应注意","opt":["A.防粘刀","B.冷却充分","C.防变形","D.粉尘防护"],"ans":"D","tip":"铸铁加工产生大量粉尘，需佩戴防护口罩。","cate":"加工参数"},
{"q":"切削参数选择的基本原则是","opt":["A.先选切深再选进给最后转速","B.任意顺序","C.先选进给再选转速最后切深","D.先选转速再选进给最后切深"],"ans":"A","tip":"参数选择原则：先切深，再进给，最后转速。","cate":"加工参数"},
{"q":"粗加工时优先保证","opt":["A.刀具寿命","B.尺寸精度","C.加工效率","D.表面质量"],"ans":"C","tip":"粗加工优先保证效率，快速去除大部分余量。","cate":"加工参数"},
{"q":"精加工时优先保证","opt":["A.成本","B.尺寸精度和表面质量","C.刀具寿命","D.加工效率"],"ans":"B","tip":"精加工优先保证尺寸精度和表面光洁度。","cate":"加工参数"},
{"q":"刀具寿命与切削速度的关系是","opt":["A.速度越快寿命越短","B.随机","C.速度越快寿命越长","D.无关系"],"ans":"A","tip":"切削速度对刀具寿命影响最大，速度越快寿命越短。","cate":"加工参数"},
{"q":"加工时出现积屑瘤会导致","opt":["A.光洁度变好","B.表面粗糙度变差","C.尺寸变小","D.刀具寿命延长"],"ans":"B","tip":"积屑瘤会破坏表面质量，应避免中速切削。","cate":"加工参数"},
{"q":"消除积屑瘤的有效方法是","opt":["A.提高转速或降低转速","B.加大进给","C.降低转速","D.干切"],"ans":"A","tip":"高速或低速切削可避开积屑瘤产生区间。","cate":"加工参数"},
{"q":"铣削时切削宽度是指","opt":["A.进给量","B.刀具直径","C.侧吃刀量","D.切深"],"ans":"C","tip":"切削宽度即侧吃刀量ae，是垂直于进给方向的切削宽度。","cate":"加工参数"},
{"q":"铣削时切削深度是指","opt":["A.侧吃刀量","B.刀具直径","C.进给量","D.背吃刀量ap"],"ans":"D","tip":"切削深度即背吃刀量ap，是沿刀具轴线方向的切削深度。","cate":"加工参数"},
{"q":"每转进给量f与每齿进给量fz的关系是","opt":["A.f=fz×Z","B.f=fz","C.f=fz+Z","D.f=fz/Z"],"ans":"A","tip":"每转进给=每齿进给×齿数（Z为刀具齿数）。","cate":"加工参数"},
{"q":"加工中心最大进给速度受限于","opt":["A.切削液","B.刀具","C.机床性能","D.工件材料"],"ans":"C","tip":"最大进给速度由机床伺服系统性能决定。","cate":"加工参数"},
{"q":"加工中心最大主轴转速受限于","opt":["A.刀具","B.机床主轴性能","C.切削液","D.工件材料"],"ans":"B","tip":"最大转速由主轴电机和轴承性能决定。","cate":"加工参数"},
{"q":"重切削时应优先选择","opt":["A.整体合金刀具","B.PCD刀具","C.高速钢刀具","D.硬质合金可转位刀具"],"ans":"D","tip":"可转位刀具刚性好，适合重切削开粗。","cate":"加工参数"},
{"q":"高速精加工时应优先选择","opt":["A.陶瓷刀具","B.整体硬质合金刀具","C.高速钢刀具","D.可转位刀具"],"ans":"B","tip":"整体合金刀精度高、动平衡好，适合高速精加工。","cate":"加工参数"},
{"q":"加工时出现尺寸不稳定应首先检查","opt":["A.刀具磨损和装夹","B.切削液","C.机床参数","D.程序"],"ans":"A","tip":"尺寸不稳定多为刀具磨损或工件装夹松动。","cate":"加工参数"},
{"q":"加工时表面粗糙度差的原因不包括","opt":["A.震刀","B.冷却充分","C.进给过大","D.刀具磨损"],"ans":"B","tip":"冷却充分能提高表面质量，不会导致粗糙度差。","cate":"加工参数"},
{"q":"球刀加工曲面时步距越小则","opt":["A.效率越高","B.刀具寿命越长","C.表面质量越好","D.加工时间越短"],"ans":"C","tip":"步距越小，表面越光滑，但加工时间越长。","cate":"加工参数"},
{"q":"牛鼻刀R角越大则","opt":["A.刚性越好","B.加工效率越低","C.刚性越差","D.表面质量越差"],"ans":"A","tip":"R角越大，刀具刚性越好，越适合开粗。","cate":"加工参数"},
